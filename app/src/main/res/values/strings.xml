    <string name="categories_title">Categories · %1$s</string>
    <string name="categories_hint">OK: show or hide a category · Menu or long-press: show or hide single channels in it. Show all goes back to the defaults: adult ones stay hidden (select one to show it). Hidden items are left out everywhere, including All, Favourites and search.</string>
    <string name="entries_hint">OK: show or hide this entry. Show all goes back to the defaults: adult ones stay hidden (select one to show it). Hidden entries are left out everywhere, including All, Favourites and search.</string>
