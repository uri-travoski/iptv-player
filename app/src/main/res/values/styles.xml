<resources>
    <style name="Text.Title" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Body" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Text.Secondary" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Input" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:imeOptions">actionNext|flagNoExtractUi</item>
    </style>

    <style name="TileButton" parent="">
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_tile</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Settings tile: icon on the left, name beside it (up to two lines), as in WorldTV2. -->
    <style name="SettingsTile" parent="TileButton">
        <item name="android:layout_height">76dp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:maxLines">3</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">1dp</item>
    </style>

    <!-- Top tab bar item (tab_bar.xml): compact; the current tab is filled. -->
    <style name="TabItem" parent="TileButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Full-screen player buttons: flat, compact, focus shown by the tile border. -->
    <style name="ControlButton" parent="TileButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Home menu tile (Live TV, Movies, Series): the main thing on screen. Icon above label, one flat view. -->
    <style name="HomeTile" parent="TileButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">250dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:drawablePadding">18dp</item>
        <item name="android:drawableTint">@color/text_primary</item>
        <item name="android:paddingTop">44dp</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Search field at the top of a category list. -->
    <style name="SearchInput" parent="Input">
        <item name="android:layout_height">44dp</item>
        <item name="android:hint">@string/search</item>
        <item name="android:imeOptions">actionSearch|flagNoExtractUi</item>
        <item name="android:inputType">text|textNoSuggestions</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Home menu tile, Mobile layout: full width, icon left of the label. -->
    <style name="HomeTileMobile" parent="TileButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">104dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:drawablePadding">20dp</item>
        <item name="android:drawableTint">@color/text_primary</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Compact home button (Settings, Reload playlist): icon left of the label. -->
    <style name="HomeSmallTile" parent="TileButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:drawableTint">@color/text_primary</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:maxLines">2</item>
    </style>

    <!-- Round icon button on the video (player and live full screen): no fill until focused or pressed. -->
    <style name="OsdIcon">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:padding">11dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/text_primary</item>
    </style>

    <!-- Play/pause: the one filled button, in the theme accent. -->
    <style name="OsdPlay" parent="OsdIcon">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:background">@drawable/bg_play_button</item>
        <item name="android:padding">17dp</item>
    </style>

    <!-- Seek-by-seconds button: a round arrow with the seconds inside. -->
    <style name="OsdSeek">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="OsdSeekNumber">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">8sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
