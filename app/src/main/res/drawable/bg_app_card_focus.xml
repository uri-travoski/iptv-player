<?xml version="1.0" encoding="utf-8"?>
<!-- Home app card: a white edge when focused, a light wash while pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="200">
    <item android:state_pressed="true">
        <shape><corners android:radius="14dp" /><solid android:color="#33FFFFFF" /><stroke android:width="3dp" android:color="#FFFFFFFF" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><corners android:radius="14dp" /><stroke android:width="3dp" android:color="#F2FFFFFF" /></shape>
    </item>
    <item>
        <shape><corners android:radius="14dp" /><stroke android:width="1dp" android:color="#24FFFFFF" /></shape>
    </item>
</selector>
