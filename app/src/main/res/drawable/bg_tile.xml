<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="250">
    <!-- Pressed first (also while focused), fading out, so every press shows. -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pressed" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Selected but not focused, e.g. the current season. -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_active" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
