<?xml version="1.0" encoding="utf-8"?>
<!-- Home slider's More info button: see-through, white when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="200">
    <item android:state_pressed="true">
        <shape><corners android:radius="10dp" /><solid android:color="?attr/wtPressed" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><corners android:radius="10dp" /><solid android:color="#F2FFFFFF" /></shape>
    </item>
    <item>
        <shape><corners android:radius="10dp" /><solid android:color="#29FFFFFF" /><stroke android:width="1dp" android:color="#4DFFFFFF" /></shape>
    </item>
</selector>
