<?xml version="1.0" encoding="utf-8"?>
<!-- List row states: flat fills and outlines, no elevation or animation. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- Touch (Mobile layout): pressed shows the accent too. -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- Playing (activated) and also the list being browsed (selected): fill + outline. -->
    <item android:state_activated="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_active" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- Playing: the channel now playing, and the category it is in. -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_active" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- Selected: the category whose list is shown. -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <color android:color="@android:color/transparent" />
    </item>
</selector>
