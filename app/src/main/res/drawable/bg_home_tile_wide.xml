<?xml version="1.0" encoding="utf-8"?>
<!-- Home tiles (TV): see-through over the slider, the theme accent with a white edge when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="200">
    <item android:state_pressed="true">
        <shape><corners android:radius="18dp" /><solid android:color="?attr/wtPressed" /><stroke android:width="2dp" android:color="#E6FFFFFF" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><corners android:radius="18dp" /><solid android:color="?attr/wtAccent" /><stroke android:width="2dp" android:color="#D9FFFFFF" /></shape>
    </item>
    <item>
        <shape><corners android:radius="18dp" /><solid android:color="?attr/wtSlot" /><stroke android:width="1dp" android:color="#24FFFFFF" /></shape>
    </item>
</selector>
