<?xml version="1.0" encoding="utf-8"?>
<!-- Round see-through icon button over the home slider (Reload, menu). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="200">
    <item android:state_pressed="true">
        <shape android:shape="oval"><solid android:color="?attr/wtPressed" /></shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval"><solid android:color="?attr/wtAccent" /><stroke android:width="2dp" android:color="#E6FFFFFF" /></shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="#26FFFFFF" /><stroke android:width="1dp" android:color="#38FFFFFF" /></shape>
    </item>
</selector>
