<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="36dp"
    android:paddingEnd="48dp">

    <TextView
        style="@style/Text.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name" />

    <TextView
        android:id="@+id/account"
        style="@style/Text.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />

    <!-- Reload progress: shown only while a reload runs, and for its result. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:minHeight="24dp"
        android:orientation="horizontal">

        <com.worldtv.iptvplayer.ui.LoadingDots
            android:id="@+id/busy"
            android:layout_width="40dp"
            android:layout_height="10dp"
            android:layout_marginEnd="12dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/reload_status"
            style="@style/Text.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Big tiles, then the rows below them (built in HomeScreen), centred in the space left.
         Scrolls only when there are more rows than the screen can show; focus brings them in. -->
    <ScrollView
        android:id="@+id/home_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tile_live"
                style="@style/HomeTile"
                android:drawableTop="@drawable/ic_live_tv"
                android:text="@string/live_tv" />

            <TextView
                android:id="@+id/tile_movies"
                style="@style/HomeTile"
                android:layout_marginStart="20dp"
                android:drawableTop="@drawable/ic_movies"
                android:text="@string/movies" />

            <TextView
                android:id="@+id/tile_series"
                style="@style/HomeTile"
                android:layout_marginStart="20dp"
                android:drawableTop="@drawable/ic_series"
                android:text="@string/series" />
        </LinearLayout>

        <!-- Rows of 5: first the user's first app + Reload playlist, App Settings, All apps and
             System settings (always on the right); more apps in rows of 5 below. -->
        <LinearLayout
            android:id="@+id/home_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical" />
    </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/version"
        style="@style/Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingBottom="20dp"
        android:textSize="14sp" />
</LinearLayout>
