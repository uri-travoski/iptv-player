<?xml version="1.0" encoding="utf-8"?>
<!-- Now / next under the live preview, from the panel's guide. Hidden when there is no guide. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/guide"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
        android:id="@+id/guide_now"
        style="@style/Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1" />

    <ProgressBar
        android:id="@+id/guide_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:max="1000"
        android:progressBackgroundTint="?attr/wtDivider"
        android:progressTint="?attr/wtAccent" />

    <TextView
        android:id="@+id/guide_next"
        style="@style/Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1" />

    <TextView
        android:id="@+id/guide_catchup"
        style="@style/Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/catchup_hint"
        android:visibility="gone" />
</LinearLayout>
