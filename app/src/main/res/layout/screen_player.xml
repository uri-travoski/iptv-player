<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen movie/episode player. Transparent: the shared PlayerView shows through, and the
     controls sit straight on the video over a soft shade (top: back + title, bottom: seek bar
     and buttons). A tap or OK shows them. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true">

    <TextView
        android:id="@+id/osd_status"
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/scrim"
        android:padding="16dp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/bg_osd_top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="40dp"
            android:paddingBottom="40dp">

            <!-- Touch only (the remote has Back). -->
            <ImageView
                android:id="@+id/ctl_exit"
                style="@style/OsdIcon"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_arrow_back"
                android:visibility="gone" />

            <TextView
                android:id="@+id/title"
                style="@style/Text.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:textSize="22sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_osd_bottom"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingTop="48dp"
            android:paddingEnd="40dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/position"
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="64dp"
                    android:textSize="15sp" />

                <!-- Drag to seek (touch). The remote seeks with Left/Right, so it never takes focus. -->
                <SeekBar
                    android:id="@+id/progress"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:focusable="false"
                    android:max="1000"
                    android:progressBackgroundTint="#66FFFFFF"
                    android:progressTint="@color/accent"
                    android:secondaryProgressTint="#99FFFFFF"
                    android:thumbTint="@color/text_primary" />

                <TextView
                    android:id="@+id/duration"
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:minWidth="64dp"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- One row, so Left/Right walks every button: track options left, transport in the
                 middle, picture options right. -->
            <LinearLayout
                android:id="@+id/controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView android:id="@+id/ctl_audio" style="@style/OsdIcon" android:contentDescription="@string/ctl_audio" android:src="@drawable/ic_audiotrack" />
                <ImageView android:id="@+id/ctl_subs" style="@style/OsdIcon" android:contentDescription="@string/ctl_subs" android:src="@drawable/ic_subtitles" />

                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <ImageView android:id="@+id/ctl_prev" style="@style/OsdIcon" android:contentDescription="@string/ctl_prev_ep" android:src="@drawable/ic_skip_previous" />
                <include layout="@layout/osd_seek_back" />
                <ImageView android:id="@+id/ctl_pause" style="@style/OsdPlay" android:contentDescription="@string/ctl_pause" android:src="@drawable/ic_pause" />
                <include layout="@layout/osd_seek_forward" />
                <ImageView android:id="@+id/ctl_next" style="@style/OsdIcon" android:contentDescription="@string/ctl_next_ep" android:src="@drawable/ic_skip_next" />

                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <ImageView android:id="@+id/ctl_aspect" style="@style/OsdIcon" android:contentDescription="@string/ctl_aspect_fit" android:src="@drawable/ic_aspect" />
                <ImageView android:id="@+id/ctl_external" style="@style/OsdIcon" android:contentDescription="@string/ctl_external" android:src="@drawable/ic_open_external" />
            </LinearLayout>
        </LinearLayout>

        <!-- Name of the focused button, placed above it (OsdTips). -->
        <TextView
            android:id="@+id/osd_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:background="@drawable/bg_osd_tip"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:visibility="invisible" />
    </FrameLayout>
</FrameLayout>
