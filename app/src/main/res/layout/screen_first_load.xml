<?xml version="1.0" encoding="utf-8"?>
<!-- First start: the free demo playlist (Free TV) loading. One centred column: TV and phone. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ProgressBar
            android:id="@+id/first_load_spinner"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminate="true"
            android:indeterminateTint="?attr/wtAccent" />

        <TextView
            android:id="@+id/first_load_title"
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:maxWidth="760dp"
            android:text="@string/first_load_title"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/first_load_status"
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:minHeight="24dp" />

        <LinearLayout
            android:id="@+id/first_load_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/first_load_retry"
                style="@style/TileButton"
                android:layout_width="wrap_content"
                android:gravity="center"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/first_load_retry"
                android:textColor="?attr/wtTextPrimary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/first_load_own"
                style="@style/TileButton"
                android:layout_width="wrap_content"
                android:layout_marginStart="16dp"
                android:gravity="center"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/first_load_own"
                android:textColor="?attr/wtTextPrimary"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- What a paid subscription adds. -->
        <TextView
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:maxWidth="760dp"
            android:text="@string/first_load_paid" />
    </LinearLayout>
</ScrollView>
