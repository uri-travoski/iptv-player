<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Live channel order: the live categories, or one category's channels to move. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/form"
        android:layout_width="640dp"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/title"
            style="@style/Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/hint"
            style="@style/Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="14sp" />

        <!-- One category: move the channel picked up, or go back to the provider's order. -->
        <LinearLayout
            android:id="@+id/buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView android:id="@+id/move_top" style="@style/TileButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="@string/order_top" android:textSize="16sp" />
            <TextView android:id="@+id/move_up" style="@style/TileButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/order_up" android:textSize="16sp" />
            <TextView android:id="@+id/move_down" style="@style/TileButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/order_down" android:textSize="16sp" />
            <TextView android:id="@+id/move_bottom" style="@style/TileButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/order_bottom" android:textSize="16sp" />
            <TextView android:id="@+id/order_reset" style="@style/TileButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:layout_weight="1.4" android:text="@string/order_reset" android:textSize="16sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />
    </LinearLayout>
</FrameLayout>
