<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">
    <!-- The app's only full-screen background. Screens are transparent over it (no overdraw on
         Mali GPUs); the theme's window background is dropped once this is laid out. -->

    <!-- The only video surface in the app. Moved and resized; gone while no screen shows video
         (see MainActivity.hideVideo). Starts gone: the first screen is the menu. Black background
         so letterbox/pillarbox bars are black, not the maroon root background. -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        android:visibility="gone"
        android:background="#FF000000"
        android:descendantFocusability="blocksDescendants"
        app:resize_mode="fit"
        app:shutter_background_color="#FF000000"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <FrameLayout
        android:id="@+id/screens"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
