<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Scrolls when there are many playlists. -->
    <ScrollView
        android:id="@+id/form"
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings" />

        <!-- TV (remote) or Mobile (touch) layout; switching rebuilds every screen. -->
        <TextView
            android:id="@+id/ui_mode"
            style="@style/TileButton"
            android:layout_width="match_parent"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical|start" />

        <!-- How everything works and how to set it up. -->
        <TextView
            android:id="@+id/help"
            style="@style/TileButton"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical|start"
            android:text="@string/help" />

        <TextView
            android:id="@+id/auto_start"
            style="@style/TileButton"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical|start"
            android:text="@string/auto_start_off" />

        <TextView
            android:id="@+id/auto_start_status"
            style="@style/Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- How many app slots the home screen shows: Left/Right (or OK) changes it. -->
        <TextView
            android:id="@+id/slot_count"
            style="@style/TileButton"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical|start" />

        <!-- Updates from GitHub: check on start (On/Off), or check now. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/auto_update"
                style="@style/TileButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical|start" />

            <TextView
                android:id="@+id/check_update"
                style="@style/TileButton"
                android:layout_width="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/update_check_now" />
        </LinearLayout>

        <!-- Which DNS WorldTV's own connections use. OK cycles through the options. -->
        <TextView
            android:id="@+id/dns"
            style="@style/TileButton"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical|start"
            android:text="@string/dns_system" />

        <!-- Make WorldTV the box's Home screen (default launcher). Shows "already" once it is. -->
        <TextView
            android:id="@+id/default_home"
            style="@style/TileButton"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical|start"
            android:text="@string/home_make_default" />

        <!-- Way out to other apps and the box's own settings: needed when WorldTV is the launcher. -->
        <LinearLayout
            android:id="@+id/launcher_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/all_apps"
                style="@style/TileButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/all_apps" />

            <TextView
                android:id="@+id/android_settings"
                style="@style/TileButton"
                android:layout_width="0dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/android_settings" />
        </LinearLayout>

        <TextView
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/playlists"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/playlists_hint"
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/playlists_hint_tv" />

        <LinearLayout
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/add"
            style="@style/TileButton"
            android:layout_width="match_parent"
            android:layout_marginTop="16dp"
            android:text="@string/add_playlist" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:minHeight="24dp"
            android:orientation="horizontal">

            <!-- Shown only while a playlist loads. -->
            <io.github.sardinemehico.iptvplayer.ui.LoadingDots
                android:id="@+id/busy"
                android:layout_width="40dp"
                android:layout_height="10dp"
                android:layout_marginEnd="12dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/message"
                style="@style/Text.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</FrameLayout>
