<?xml version="1.0" encoding="utf-8"?>
<!-- Home, Mobile (portrait): Live TV, Movies and Series stacked, then Reload playlist and App
     Settings (built in HomeScreen). No app slots: those are for TV boxes using WorldTV as launcher. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp">

    <TextView
        style="@style/Text.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name" />

    <TextView
        android:id="@+id/account"
        style="@style/Text.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="14sp" />

    <!-- Reload progress: shown only while a reload runs, and for its result. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:minHeight="24dp"
        android:orientation="horizontal">

        <io.github.sardinemehico.iptvplayer.ui.LoadingDots
            android:id="@+id/busy"
            android:layout_width="40dp"
            android:layout_height="10dp"
            android:layout_marginEnd="12dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/reload_status"
            style="@style/Text.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="14sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/home_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/tile_live"
                style="@style/HomeTileMobile"
                android:drawableStart="@drawable/ic_live_tv"
                android:text="@string/live_tv" />

            <TextView
                android:id="@+id/tile_movies"
                style="@style/HomeTileMobile"
                android:drawableStart="@drawable/ic_movies"
                android:text="@string/movies" />

            <TextView
                android:id="@+id/tile_series"
                style="@style/HomeTileMobile"
                android:drawableStart="@drawable/ic_series"
                android:text="@string/series" />

            <LinearLayout
                android:id="@+id/home_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/version"
        style="@style/Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:textSize="13sp" />
</LinearLayout>
